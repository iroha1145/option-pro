{
  "channel": "api.sharadar.com",
  "base_url": "https://api.sharadar.com/v1.0/data",
  "docs": [
    "https://sharadar.com/docs/auth",
    "https://sharadar.com/docs/stocks",
    "https://sharadar.com/docs/funds",
    "https://sharadar.com/docs/tickers",
    "https://sharadar.com/docs/actions",
    "https://sharadar.com/docs/faqs",
    "https://sharadar.com/blog/posts/sharadar-stock-prices-fund-prices-and-adjustments"
  ],
  "tables": {
    "stocks": {
      "alias": "SEP",
      "logical": "equity_eod"
    },
    "funds": {
      "alias": "SFP",
      "logical": "fund_eod"
    },
    "tickers": {
      "alias": "TICKERS",
      "logical": "security_master"
    },
    "actions": {
      "alias": "ACTIONS",
      "logical": "corporate_actions"
    }
  },
  "fields": {
    "stocks": [
      "ticker",
      "date",
      "open",
      "high",
      "low",
      "close",
      "volume",
      "closeadj",
      "closeunadj",
      "lastupdated"
    ],
    "funds": [
      "ticker",
      "date",
      "open",
      "high",
      "low",
      "close",
      "volume",
      "closeadj",
      "closeunadj",
      "lastupdated"
    ],
    "tickers": [
      "permaticker",
      "ticker",
      "name",
      "exchange",
      "isdelisted",
      "category",
      "currency",
      "siccode",
      "sicsector",
      "sicindustry",
      "famaindustry",
      "sector",
      "industry",
      "location",
      "firstpricedate",
      "lastpricedate",
      "relatedtickers",
      "cusips",
      "figi",
      "scalemarketcap",
      "lastupdated"
    ],
    "actions": [
      "date",
      "action",
      "ticker",
      "name",
      "value",
      "contraticker",
      "contraname"
    ]
  },
  "formula_version": "sharadar-raw-imputation-v1",
  "credential_env": "SHARADAR_API_KEY",
  "nasdaq_data_link_client": false
}
