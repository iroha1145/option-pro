# 模型、推理等级、任务频率和保留周期统一由 config/personal.toml 管理。
# 运行时依次读取 .env、machine.env、secrets.env；进程导出的环境变量优先级最高。
# 此兼容模板只保存密钥、远端地址和本机网络边界，真实值不得提交。

# 可选服务密钥
OPENAI_API_KEY=
MASSIVE_API_KEY=
FINNHUB_API_KEY=
MARKETDATA_TOKEN=

# MacroLens 只读连接；生产地址必须使用 HTTPS。
MACROLENS_URL=
INTERNAL_API_TOKEN=
MACROLENS_CA_BUNDLE=

# 本机监听与访问保护
HOST_BIND=127.0.0.1
PORT=2000
APP_AUTH_TOKEN=
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
PUBLIC_READ_API_ENABLED=false
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
ALLOW_INSECURE_PUBLIC_BIND=false
