# Personal Edition deployment edges only. Secrets belong in secrets.env.

# Host binding. private_network mode rejects wildcard and public addresses.
HOST_BIND=127.0.0.1
PORT=2000

# Option Pro -> MacroLens read-only ETL origin. Production must use HTTPS.
MACROLENS_URL=

# Reverse-proxy boundary for password mode.
ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
