# Personal Edition machine edges only. Secrets belong in secrets.env.
# The access mode is read from config/personal.toml, never from this file.

# Host binding. private_network mode rejects wildcard and public addresses.
HOST_BIND=127.0.0.1
PORT=2000

# Option Pro -> MacroLens read-only ETL origin. Production must use HTTPS.
MACROLENS_URL=

# Reverse-proxy boundary. Password mode still requires APP_PASSWORD_HASH in secrets.env.
ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
