# OpenAI Responses API (optional; leave the key empty to disable AI analysis)
OPENAI_API_KEY=
# Leave blank for OpenAI's official endpoint. If you set a third-party proxy,
# use only a key issued by that proxy; never send your official OpenAI key to it.
OPENAI_BASE_URL=
# Required opt-in when OPENAI_BASE_URL is non-empty.
ALLOW_CUSTOM_OPENAI_BASE_URL=false
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_REASONING=low
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=0
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_MAX_CONCURRENCY=2

# Local bind. Default is localhost-only for personal use.
HOST_BIND=127.0.0.1
PORT=2000

# Optional authentication. For remote access, keep the app on localhost and use
# an SSH tunnel/VPN, or place it behind an HTTPS reverse proxy. Do not expose it
# directly over plain HTTP because the browser token would travel unencrypted.
# In the browser, run:
# sessionStorage.setItem('optix.app.token', 'same-token-here'); location.reload();
APP_AUTH_TOKEN=
TRUST_PROXY_HEADERS=false
# Comma-separated proxy source networks. Required when proxy headers are trusted.
TRUSTED_PROXY_CIDRS=
# Add every public reverse-proxy domain here, for example option.example.com.
# Leave empty only for localhost/SSH/VPN access using HOST_BIND directly.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# Refuse a non-loopback HOST_BIND when APP_AUTH_TOKEN is empty. Leave this false.
# Set true only for an intentionally unauthenticated private network protected by
# an external firewall/VPN; it must never be used for plain public HTTP.
ALLOW_INSECURE_PUBLIC_BIND=false

# Massive.com (optional, not used in current version)
MASSIVE_API_KEY=

# Finnhub (optional, used by Strength Radar for company/fundamental enrichment)
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_ENRICH_LIMIT=20
FINNHUB_CANDLE_FALLBACK_ENABLED=true
FINNHUB_CANDLE_FALLBACK_LIMIT=80
STOOQ_PRICE_FALLBACK_ENABLED=true
STOOQ_PRICE_FALLBACK_LIMIT=260

# Yahoo/yfinance options broad screen (no API key)
# This runs before ranking is finalized, so option heat can promote candidates.
YAHOO_OPTIONS_ENABLED=true
YAHOO_OPTIONS_ENRICH_LIMIT=90
YAHOO_OPTION_TARGET_DTE=30
YAHOO_OPTION_MIN_DTE=14
YAHOO_OPTION_MAX_DTE=60
YAHOO_OPTION_STRIKE_WINDOW_PCT=0.16
YAHOO_OPTIONS_FAILURE_LIMIT=8

# MarketData.app (optional, used by Strength Radar for options heat)
# Official SDKs read MARKETDATA_TOKEN. MARKETDATA_API_TOKEN is also accepted by this app.
MARKETDATA_TOKEN=
MARKETDATA_BASE_URL=https://api.marketdata.app
MARKETDATA_STOCK_CANDLE_FALLBACK_ENABLED=true
MARKETDATA_STOCK_CANDLE_FALLBACK_LIMIT=260
MARKETDATA_OPTIONS_ENRICH_LIMIT=8
MARKETDATA_OPTION_DTE=30
MARKETDATA_OPTION_STRIKE_LIMIT=8
MARKETDATA_OPTION_MODE=delayed

# Breakout Radar bootstrap defaults. These values are conservative starting
# points, not claims of historically optimal parameters. The worker stays off
# until it is explicitly enabled.
BREAKOUT_RADAR_ENABLED=false
DEPLOY_REQUIRE_BREAKOUT=false
BREAKOUT_DISCOVERY_PROVIDER=tradingview
BREAKOUT_DB_PATH=/data/optix.db

BREAKOUT_PROVIDER_TIMEOUT_SECONDS=10
BREAKOUT_PROVIDER_CONNECT_TIMEOUT_SECONDS=2
BREAKOUT_PROVIDER_READ_TIMEOUT_SECONDS=4
BREAKOUT_PROVIDER_RETRY_ATTEMPTS=2
BREAKOUT_PROVIDER_RETRY_AFTER_CAP_SECONDS=2
BREAKOUT_PROVIDER_CACHE_TTL_SECONDS=60
BREAKOUT_PROVIDER_STALE_TTL_SECONDS=900
BREAKOUT_PROVIDER_FAILURE_THRESHOLD=3
BREAKOUT_PROVIDER_CIRCUIT_OPEN_SECONDS=300
BREAKOUT_PROVIDER_MAX_RESPONSE_BYTES=2000000
BREAKOUT_PROVIDER_RESULT_LIMIT=150
BREAKOUT_PROVIDER_MAX_CONCURRENCY=4
BREAKOUT_PROVIDER_MIN_MARKET_CAP=200000000
BREAKOUT_PROVIDER_SCHEMA_VERSION=tradingview-discovery-v1
BREAKOUT_ALLOW_ETF=true

BREAKOUT_DAILY_ENRICH_LIMIT=60
BREAKOUT_INTRADAY_ENRICH_LIMIT=30
BREAKOUT_EXPIRED_DUE_LIMIT=40
BREAKOUT_SCAN_INTERVAL_PREMARKET_SECONDS=600
BREAKOUT_SCAN_INTERVAL_REGULAR_SECONDS=300
BREAKOUT_SCAN_INTERVAL_CLOSED_SECONDS=1800
BREAKOUT_WORKER_LEASE_TTL_SECONDS=90
BREAKOUT_WORKER_HEALTH_STALE_SECONDS=120
BREAKOUT_RAW_PAYLOAD_RETENTION_HOURS=24
BREAKOUT_SCAN_RETENTION_DAYS=30
BREAKOUT_RETENTION_BATCH_SIZE=500

BREAKOUT_MIN_PRICE=2.0
BREAKOUT_MIN_AVG_DOLLAR_VOLUME=10000000
BREAKOUT_REGULAR_MIN_CHANGE_PCT=3.0
BREAKOUT_REGULAR_MIN_RELATIVE_VOLUME=1.5
BREAKOUT_REGULAR_MIN_DOLLAR_VOLUME=5000000
BREAKOUT_PREMARKET_MIN_CHANGE_PCT=5.0
BREAKOUT_PREMARKET_MIN_DOLLAR_VOLUME=500000

BREAKOUT_BASE_MIN_DAYS=10
BREAKOUT_BASE_MAX_DAYS=80
BREAKOUT_PIVOT_TOLERANCE_ATR=0.50
BREAKOUT_BREAK_BUFFER_ATR=0.10
BREAKOUT_BREAK_BUFFER_PCT=0.0025
BREAKOUT_OPENING_RANGE_MINUTES=30
BREAKOUT_CONFIRMATION_BARS=2
BREAKOUT_MAX_CHASE_DISTANCE_ATR=2.0
BREAKOUT_EVENT_TTL_SECONDS=86400

BREAKOUT_SCORING_VERSION=breakout-score-v1
BREAKOUT_FEATURE_VERSION=breakout-features-v1
BREAKOUT_DETECTOR_VERSION=breakout-detector-v1
BREAKOUT_API_SCHEMA_VERSION=breakout-api-v1

# Deterministic replay bootstrap values; these are engineering defaults.
MARKET_SHAPE_ENTER_CONFIRM_DAYS=2
MARKET_SHAPE_EXIT_CONFIRM_DAYS=2
MARKET_SHAPE_MIN_DWELL_DAYS=3
MARKET_SHAPE_HISTORY_DAYS=20

RANGE_PERSISTENCE_MODE=shadow
RANGE_PERSISTENCE_VERSION=range-persistence-v1
# Keep empty in shadow/disabled. Enabling production requires this to equal VERSION.
RANGE_PERSISTENCE_VALIDATION_VERSION=
RANGE_PERSISTENCE_LENGTH=35
RANGE_PERSISTENCE_FAST_LENGTH=3
RANGE_PERSISTENCE_SLOPE_DAYS=5
RANGE_PERSISTENCE_RATIO_WINDOW=10
RANGE_PERSISTENCE_RATIO_THRESHOLD=60
RANGE_PERSISTENCE_MIN_HISTORY_MULTIPLIER=5
RANGE_PERSISTENCE_TREND_FAMILY_WEIGHT=0.15
RANGE_PERSISTENCE_FINAL_WEIGHT_CAP=0.04
RANGE_PERSISTENCE_BREAKOUT_INTERACTION_ENABLED=false
RANGE_PERSISTENCE_BREAKOUT_INTERACTION_CAP=4.0
