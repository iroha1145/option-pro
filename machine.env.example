# Copy to machine.env on the server. This file contains no service secrets.
HOST_BIND=127.0.0.1
PORT=2000
MACROLENS_URL=
ALLOWED_HOSTS=127.0.0.1
# Direct bind stays false. Behind Cloudflare / nginx, set true and list the
# hop that appends X-Forwarded-For, or every visitor shares one 8-stream bucket.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
DATA_DIR=/data
